# =============================================================================
# Fiscal de Mailings — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca commitar .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (OBRIGATÓRIO)
# -----------------------------------------------------------------------------
# URL do projeto Supabase. Disponível em: Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Chave pública (anon). Disponível em: Settings → API → Project API keys → anon public.
# Pode ir para o cliente — é segura para exposição.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de service role. Disponível em: Settings → API → Project API keys → service_role.
# ATENÇÃO: só use server-side (Route Handlers / Server Actions). NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# Gemini Flash (OPCIONAL)
# -----------------------------------------------------------------------------
# Quando definida, ativa (1) a Camada B do motor de comparação para resolver
# casos ambíguos que a Camada A determinística não conseguiu decidir e
# (2) a pesquisa ampla complementar (2ª etapa) via grounding Google Search,
# acionada só para casos não resolvidos pela URL oficial. Ambas no plano grátis.
# Sem essa chave, o app usa só a Camada A sobre a URL oficial cadastrada.
# Obtenha em: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
